# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=dev                          # dev | test | qa | prod
APP_PORT=8001
APP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# Internal API key — for service-to-service calls (eventually Java side)
# Generate: openssl rand -base64 32
INTERNAL_API_KEY=replace-me-with-strong-secret

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Local docker-compose default — override for production
DATABASE_URL=postgresql+psycopg://ai_agent:ai_agent@postgres:5432/ai_agent_system
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─────────────────────────────────────────────
# LLM — OpenRouter (single gateway, all models)
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://your-domain.com    # для OpenRouter dashboard ranking
OPENROUTER_APP_TITLE=ai-agent-system

# Per-operation routing config (defaults — override via configs/llm_routing.yml)
LLM_ROUTING_CONFIG_PATH=./configs/llm_routing.yml

# ─────────────────────────────────────────────
# Cost controller
# ─────────────────────────────────────────────
COST_PER_CALL_MAX_USD=0.30
COST_PER_SNAPSHOT_SOFT_USD=0.50
COST_PER_SNAPSHOT_HARD_USD=1.50
COST_DAILY_CAP_USD=5.00
COST_KILL_SWITCH_ENABLED=false       # toggle via /api/admin/cost/freeze

# ─────────────────────────────────────────────
# Firecrawl (per N1 research — self-hosted primary, Jina Reader fallback)
# ─────────────────────────────────────────────
FIRECRAWL_BASE_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=anything-self-host-ignores-it
FIRECRAWL_TIMEOUT_SECONDS=45
FIRECRAWL_MOBILE_PARALLEL=true       # per N1: 2 parallel calls > 1 viewport-switch

# Fallback chain
FALLBACK_JINA_READER_URL=https://r.jina.ai
FALLBACK_FIRECRAWL_CLOUD_KEY=        # optional — paid fallback for hardened pages

# ─────────────────────────────────────────────
# Knowledge / Obsidian
# ─────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/vault            # mounted volume у docker-compose
KNOWLEDGE_ETL_WATCH_ENABLED=true      # watchdog file watcher
KNOWLEDGE_ETL_NIGHTLY_CRON_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─────────────────────────────────────────────
# Tracing / Observability (per N10 research — refine after)
# ─────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_replace-me
LANGSMITH_PROJECT=ai-agent-system
LANGSMITH_SAMPLING_RATE=1.0           # 0.1 на dev для збереження free tier

# ─────────────────────────────────────────────
# Rate limiting (basic)
# ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20

# ─────────────────────────────────────────────
# CORS (for future UI / future integration)
# ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
